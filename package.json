{
  "name": "med-dashboard",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "party:dev": "partykit dev",
    "party:deploy": "partykit deploy",
    "pages:deploy": "wrangler pages deploy dist --project-name med-dashboard",
    "electron:bundle": "esbuild electron/main.ts --bundle --platform=node --external:electron --format=cjs --outfile=electron-dist/main.cjs && esbuild electron/preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=electron-dist/preload.cjs",
    "electron:dev": "npm run build && npm run electron:bundle && electron .",
    "electron:pack": "npm run build && npm run electron:bundle && electron-builder --win portable",
    "portable:pack": "npm run build && node scripts/pack-portable.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "partysocket": "^1.3.0",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.17",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "partykit": "^0.0.115",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "local.meddashboard.lan",
    "productName": "MedBoard-LAN",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-dist/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "MedBoard-LAN.exe"
    }
  }
}
